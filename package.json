{
  "name": "registo-gravidas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Registo de grávidas — app autocontida (index.html) com armazenamento event-sourced numa pasta partilhada do OneDrive.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
